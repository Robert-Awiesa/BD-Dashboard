# Copy to Server/.env for local development. Never commit the real file.
# On Render these are set under Environment in the service dashboard.

PORT=5001

# MongoDB Atlas connection string.
# Atlas > Database > Connect > Drivers. Include the password in the URI.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=bd_workspace

# Only needed if the frontend is hosted separately from the API.
# Comma-separated list of allowed origins. Leave unset for a single service.
# CORS_ORIGINS=https://your-frontend.example.com

# Set to true to stop the nightly reminder sweep (e.g. on a second instance,
# so the job does not run twice).
# DISABLE_CRON=false

# --- File storage -----------------------------------------------------------
# Uploads go to Cloudinary when these are set, and to GridFS in MongoDB when
# they are not — so a local checkout works with nothing configured.
#
# Cloudinary > Dashboard > API Keys. Either the single URL or the three values.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=000000000000000
# CLOUDINARY_API_SECRET=your-api-secret

# Folder everything is filed under, so one account can host several projects.
# CLOUDINARY_FOLDER=bd-workspace
